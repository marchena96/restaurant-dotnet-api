# ASP.NET Core configuration placeholders. Replace every value outside source control.
JwtSettings__SecretKey=<at-least-32-byte-signing-secret>
JwtSettings__Issuer=<token-issuer>
JwtSettings__Audience=<token-audience>
JwtSettings__ExpiryInDays=<1-to-365>
ConnectionStrings__ConnectionSql=<sql-server-connection-string>
